  "narrative": {
    "northStar": "The Room After Closing",
    "overview": "Every screen is a lit aquarium window beside its museum label, in a dark tank room. Colour lives only inside lit tanks and on plates.",
    "keyCharacteristics": [
      "Dark indigo ground, colour quarantined to tanks and plates.",
      "Two surface families: lit tank (28px) and label stock (6px).",
      "Moon blue is action and correct; coral mistake; flame streak; rose Minh.",
      "Signature motion: jellyfish pulse on correct, doze on wrong."
    ],
    "rules": [
      {
        "name": "The Quarantine Rule",
        "body": "Saturated colour appears only inside a tank or on a plate. The page ground stays indigo.",
        "section": "colors"
      },
      {
        "name": "The One Blue Rule",
        "body": "Moon blue means act here or right. Do not reuse it as decoration.",
        "section": "colors"
      },
      {
        "name": "The Label Ink Rule",
        "body": "Text on label stock is label-ink or label-mist, never white and never an accent.",
        "section": "colors"
      },
      {
        "name": "The Guide Word Rule",
        "body": "Orientation is a plain sentence-case guide line at the head of the screen, not decorative micro-labels.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number that changes uses tabular-nums.",
        "section": "typography"
      },
      {
        "name": "The Soft Light Rule",
        "body": "Shadows are diffuse and tinted by the ground; no hard offset shadows.",
        "section": "elevation"
