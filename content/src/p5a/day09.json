 "theory": [
  {
   "id": "d09-th-1",
   "title": {
    "vi": "At / on / in và by / until / for",
    "en": "Prepositions of time and place"
   },
   "rule": {
    "vi": "AT + giờ, điểm. ON + thứ, ngày, mặt phẳng. IN + tháng, năm, không gian. BY = trước hoặc đúng hạn. UNTIL = kéo dài đến. FOR + khoảng thời gian. SINCE + mốc.",
    "en": "AT + clock time, point. ON + day, date, surface. IN + month, year, enclosed space. BY = no later than. UNTIL = continues up to. FOR + duration. SINCE + starting point."
   },
   "formula": "at 9:30 | on Tuesday | in July | by Friday | until May 1 | for 3 days | since 2019",
   "examples": [
    {
     "en": "The meeting begins at 9:30 A.M.",
     "vi": "Giờ cụ thể dùng at."
    },
    {
     "en": "Please submit the form by Friday.",
     "vi": "By là hạn chót."
    },
    {
     "en": "We have worked here since 2019.",
     "vi": "Since + mốc thời gian."
    }
   ],
   "tip": "Mẹo thi: hỏi \"việc này làm một lần trước hạn\" thì chọn by; \"việc này kéo dài đến lúc đó\" thì chọn until. Nhớ by = bơi tới bờ, until = bơi mãi tới bờ."
  }
 ]
